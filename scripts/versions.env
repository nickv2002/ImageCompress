# Pinned third-party source versions shared by the build and source-tarball
# scripts. Source with: set -a; . scripts/versions.env; set +a
# gifsicle is GPL-2.0-only and is bundled as a separate executable; its source
# tarball is re-published with every release (GPL "same place" offer).
GIFSICLE_VERSION=1.98
GIFSICLE_URL=https://www.lcdf.org/gifsicle/gifsicle-1.98.tar.gz
GIFSICLE_SHA256=e9d4cc0816db95c64d32e79f778836db0f1f7eb15868490bd330104e5146b66e
# google/jpegli checkout (with submodules) used by crates/jpegli-sys.
JPEGLI_COMMIT=031a0077f5799a6041004267fc12b956c1f52a20
JPEGLI_GIT=https://github.com/google/jpegli.git
